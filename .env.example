# Preferred local ports
VITE_PORT=5174
VITE_PREVIEW_PORT=4174

# Set to true to fail if preferred port is occupied.
# Default behavior is automatic fallback to the next free port.
VITE_STRICT_PORT=false

# Optional local HTTPS (requires valid cert+key file paths)
VITE_DEV_HTTPS=false
# VITE_DEV_SSL_CERT=certs/localhost.pem
# VITE_DEV_SSL_KEY=certs/localhost-key.pem
