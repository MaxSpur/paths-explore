{
  "bundle_id": "emg-weighted-od-sample",
  "bundle_name": "EMG Weighted OD Sample",
  "simplification_tolerance_meters": 25.0,
  "inputs": [
    {
      "kind": "weighted_od_graph",
      "path": "data/emg-base-des-deplacements.parquet",
      "origin_code_column": "code_insee_o",
      "origin_name_column": "com_o",
      "destination_code_column": "code_insee_d",
      "destination_name_column": "com_d",
      "centroid_column": "centroid_o",
      "weight_column": "poids_jour",
      "duration_column": "duree",
      "departure_time_column": "heure_o",
      "categorical_metrics": [
        { "column": "type_od", "label": "OD Type" },
        { "column": "mode_principal", "label": "Mode" },
        { "column": "motif_o", "label": "Origin Motif" },
        { "column": "motif_d", "label": "Destination Motif" }
      ],
      "edge_limit": 2500,
      "edge_sampling_mode": "top_weight",
      "exclude_self_loops": true
    }
  ]
}
